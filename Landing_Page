<script>
  (function () {
    var ids = ["bottle", "size", "pour", "price", "target"];
    var el = {};
    ids.forEach(function (id) { el[id] = document.getElementById(id); });
    var pctEl = document.getElementById("pct");
    var perEl = document.getElementById("per");
    var statusEl = document.getElementById("status");

    function num(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }

    function update() {
      var bottle = num(el.bottle.value);
      var ounces = num(el.size.value);
      var pour = num(el.pour.value);
      var price = num(el.price.value);
      var target = num(el.target.value);

      if (!ounces || !price) {
        pctEl.textContent = "--";
        perEl.textContent = "Enter a menu price";
        statusEl.textContent = "";
        return;
      }
      var cost = (bottle / ounces) * pour;
      var pct = (cost / price) * 100;
      pctEl.textContent = pct.toFixed(1) + "%";
      perEl.textContent = "$" + cost.toFixed(2) + " cost per drink";

      var diff = pct - target;
      if (diff <= 0) {
        statusEl.textContent = "Under your target";
        statusEl.className = "status good";
      } else {
        statusEl.textContent = diff.toFixed(1) + " points over your target";
        statusEl.className = "status warn";
      }
    }

    ids.forEach(function (id) {
      el[id].addEventListener("input", update);
      el[id].addEventListener("change", update);
    });
    document.getElementById("year").textContent = new Date().getFullYear();
    update();
  })();
</script>
