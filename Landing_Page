<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blake Herring | Bar and restaurant apps, reporting, and dashboards</title>
<meta name="description" content="Cocktail apps, automated reporting, and professional dashboards for bars and restaurants, built by a 10-year bar manager in Google Workspace.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #F4F6F2;
    --card: #FFFFFF;
    --ink: #1B2420;
    --muted: #52615A;
    --bottle: #1F4D43;
    --bottle-deep: #163A32;
    --brass: #9C7027;
    --brass-soft: #EFE4CC;
    --line: #D3DCD6;
    --good: #2F6B4F;
    --warn: #9A4A1F;
    --serif: "Young Serif", Georgia, "Times New Roman", serif;
    --sans: "Public Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0E1815;
      --card: #14221E;
      --ink: #E4EBE7;
      --muted: #9DAEA6;
      --bottle: #7DB5A3;
      --bottle-deep: #1B3B33;
      --brass: #D3A75B;
      --brass-soft: #2E2817;
      --line: #263731;
      --good: #7FC4A0;
      --warn: #E59A6E;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; display: block; }
  a { color: var(--bottle); }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
    outline: 3px solid var(--brass);
    outline-offset: 2px;
  }

  .wrap { width: min(1120px, 100% - 2.5rem); margin-inline: auto; }

  /* Header */
  .site-header { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .brand { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .nav a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
  .nav a:hover { color: var(--ink); }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.8rem 1.35rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid var(--bottle);
  }
  .btn-primary { background: var(--bottle); color: var(--paper); }
  .btn-primary:hover { background: var(--bottle-deep); border-color: var(--bottle-deep); color: #fff; }
  .btn-ghost { color: var(--bottle); background: transparent; }
  .btn-ghost:hover { background: var(--card); }

  /* Hero */
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem); }
  .hero .wrap { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 5.2vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
    max-width: 16ch;
  }
  .hero p.lede { font-size: 1.2rem; color: var(--muted); max-width: 46ch; margin: 0 0 2rem; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* Spec ticket calculator: the one bold element */
  .ticket {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 6px solid var(--brass);
    border-radius: 4px 4px 10px 10px;
    padding: 1.5rem 1.5rem 1.25rem;
    position: relative;
  }
  .ticket::after {
    content: "";
    position: absolute;
    left: 1.5rem; right: 1.5rem; bottom: 5.9rem;
    border-bottom: 2px dashed var(--line);
  }
  .ticket h2 { font-family: var(--serif); font-weight: 400; font-size: 1.45rem; margin: 0 0 0.25rem; }
  .ticket .sub { color: var(--muted); font-size: 0.92rem; margin: 0 0 1.25rem; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1rem; }
  .field label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--muted); margin-bottom: 0.3rem; }
  .field input, .field select {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--paper);
    color: var(--ink);
  }
  .result { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-top: 2.6rem; }
  .result .pct { font-family: var(--serif); font-size: 3.2rem; line-height: 1; }
  .result .detail { text-align: right; font-size: 0.92rem; color: var(--muted); }
  .result .status { font-weight: 600; }
  .status.good { color: var(--good); }
  .status.warn { color: var(--warn); }
  .ticket-note { font-size: 0.85rem; color: var(--muted); margin: 1rem 0 0; }

  /* Sections */
  section.block { padding: clamp(3.5rem, 7vw, 5.5rem) 0; border-top: 1px solid var(--line); }
  .block h2.title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    max-width: 22ch;
  }
  .block p.intro { color: var(--muted); max-width: 60ch; margin: 0 0 2.5rem; }

  /* Services as menu rows */
  .menu { list-style: none; margin: 0; padding: 0; }
  .menu li {
    display: grid;
    grid-template-columns: 15rem 1fr 15rem;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .menu li:first-child { border-top: 1px solid var(--line); }
  .menu h3 { font-family: var(--serif); font-weight: 400; font-size: 1.35rem; margin: 0; line-height: 1.25; }
  .menu p { margin: 0; max-width: 52ch; }
  .menu .replaces { font-size: 0.92rem; color: var(--muted); }
  .menu .replaces strong { color: var(--ink); font-weight: 600; display: block; }

  /* Operator band */
  .band { background: var(--bottle-deep); color: #EAF1ED; }
  .band .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .band h2.title { color: #fff; }
  .band p { color: #C9D7D0; max-width: 52ch; margin: 0 0 1rem; }
  .band ul { margin: 0; padding: 0; list-style: none; }
  .band li { padding: 0.9rem 0; border-bottom: 1px solid rgba(255,255,255,0.14); color: #EAF1ED; }
  .band li:first-child { padding-top: 0; }
  .band li strong { color: #F0D9A8; font-weight: 600; }

  /* Work */
  .work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; }
  .work-grid figure { margin: 0; }
  .work-grid figure.wide { grid-column: 1 / -1; }
  .shot {
    aspect-ratio: 16 / 10;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
    padding: 1rem;
    overflow: hidden;
  }
  .work-grid figure.wide .shot { aspect-ratio: 21 / 9; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }
  .live-shot { padding: 0; position: relative; display: block; text-decoration: none; color: inherit; }
  .live-shot iframe {
    position: absolute; top: 0; left: 0;
    width: 200%; height: 200%; border: 0;
    transform: scale(0.5); transform-origin: 0 0;
    pointer-events: none;
  }
  .live-shot .live-tag {
    position: absolute; right: 0.75rem; bottom: 0.75rem;
    background: var(--bottle); color: var(--paper);
    font-size: 0.85rem; font-weight: 600;
    padding: 0.45rem 0.8rem; border-radius: 5px;
  }
  .live-shot:hover .live-tag { background: var(--bottle-deep); color: #fff; }
  .demo-link { display: inline-block; margin-top: 0.5rem; font-weight: 600; }
  .sample-note { font-size: 0.85rem; color: var(--muted); margin-top: 0.35rem; }
  figcaption { margin-top: 0.9rem; }
  figcaption h3 { font-family: var(--serif); font-weight: 400; font-size: 1.25rem; margin: 0 0 0.3rem; }
  figcaption p { margin: 0; color: var(--muted); max-width: 54ch; }

  /* Process: a real sequence, so it's numbered */
  .steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .steps li { counter-increment: step; border-top: 2px solid var(--brass); padding-top: 1rem; }
  .steps li::before { content: counter(step); font-family: var(--serif); font-size: 1.6rem; color: var(--brass); display: block; margin-bottom: 0.4rem; }
  .steps h3 { margin: 0 0 0.4rem; font-size: 1.05rem; font-weight: 700; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  /* Contact */
  .contact .wrap { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: end; }
  .contact-details { font-size: 1rem; }
  .contact-details p { margin: 0 0 0.5rem; }
  .contact-details .label { color: var(--muted); font-size: 0.88rem; display: block; }

  .site-footer { padding: 2rem 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }

  /* Responsive */
  @media (max-width: 960px) {
    .menu li { grid-template-columns: 1fr; gap: 0.6rem; }
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 820px) {
    .hero .wrap, .band .wrap, .contact .wrap { grid-template-columns: 1fr; }
    .work-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .fields { grid-template-columns: 1fr; }
    .ticket::after { display: none; }
    .result { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 2px dashed var(--line); }
    .steps { grid-template-columns: 1fr; }
    .nav { gap: 1rem; }
  }
</style>
</head>
<body>

